# По умолчанию — эмулятор Keitaro из fake_keitaro/ (uvicorn fake_keitaro.app:app --port 8001).
# Для настоящего трекера: адрес без /admin_api/v1 и ключ из «Профиль → API ключи».
KEITARO_URL=http://127.0.0.1:8001
KEITARO_API_KEY=fake-key

# SQLite по умолчанию; для Postgres: postgresql+psycopg://user:pass@localhost:5432/keitaro
DATABASE_URL=sqlite:///./keitaro_manager.db

# Куда первый поток отправляет посетителей из выбранного гео
GEO_REDIRECT_URL=https://google.com
